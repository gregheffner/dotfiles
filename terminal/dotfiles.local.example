# Copy to ~/.dotfiles.local and edit. Sourced by .zshrc; never committed.
# --- jump hosts
alias 2jump='ssh bastion'
# --- devices whose SSH key lives only in 1Password (see opssh in .zshrc)
export OPSSH_VAULT="SSH KEYS"
