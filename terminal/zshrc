# ~/.zshrc — powerlevel10k + oh-my-zsh. Personal hosts/secrets live in ~/.dotfiles.local (untracked).
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

function add_to_fpath() { for dir; do [[ -d "$dir" && ":${fpath[*]}:" != *":$dir:"* ]] && fpath=("$dir" $fpath); done; }
function add_to_path()  { for dir; do [[ -d "$dir" && ":${path[*]}:"  != *":$dir:"* ]] && path=("$dir" $path);   done; }

plugins=(
  zsh-completions
  zsh-autosuggestions
  git
  history-substring-search
  zsh-syntax-highlighting
)

export ZSH="$HOME/.oh-my-zsh"
fpath+=${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src

# macOS (Homebrew) vs Linux (linuxbrew optional)
[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"
[[ -x /home/linuxbrew/.linuxbrew/bin/brew ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
# 1Password SSH agent, if the desktop app is installed
_op_sock=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
[[ -S $_op_sock ]] && export SSH_AUTH_SOCK=$_op_sock
[[ -S ~/.1password/agent.sock ]] && export SSH_AUTH_SOCK=~/.1password/agent.sock

source ~/powerlevel10k/powerlevel10k.zsh-theme
source $ZSH/oh-my-zsh.sh

# --- aliases that only need the tool to exist
command -v lsd     >/dev/null && alias ls='lsd --group-dirs first'
alias la='ls -a'; alias lla='ls -la'; alias l='ls -l'
command -v lsd     >/dev/null && alias lt='ls --tree'
command -v cmatrix >/dev/null && alias matrix='cmatrix -n -s 94 -l o'
command -v pyenv   >/dev/null && { export PYENV_ROOT="$HOME/.pyenv"; eval "$(pyenv init -)"; }
command -v op      >/dev/null && { eval "$(op completion zsh)"; compdef _op op; }
command -v thefuck >/dev/null && eval "$(thefuck --alias)"
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# print the banner again when an ssh session ends
ssh() {
  command ssh "$@"
  if [ $? -eq 0 ] && [ -x ~/.local/bin/banner ]; then
    echo -e "\033[1;33m----------------------------------------\033[0m"
    echo -e "\033[1;36mYou have returned to $(hostname)!\033[0m"
    echo -e "\033[1;33m----------------------------------------\033[0m"
    ~/.local/bin/banner
  fi
}

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

function gi() { curl -sLw "\n" https://www.toptal.com/developers/gitignore/api/$@ ;}

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
[ -s "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
export BUN_INSTALL="$HOME/.bun"; [ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

if command -v gh >/dev/null && gh extension list 2>/dev/null | grep -q 'github/gh-copilot'; then
  copilot_shell_suggest() { gh copilot suggest -t shell "$@"; }; alias '??'='copilot_shell_suggest'
  copilot_git_suggest()   { gh copilot suggest -t git   "$@"; }; alias 'git?'='copilot_git_suggest'
  copilot_gh_suggest()    { gh copilot suggest -t gh    "$@"; }; alias 'gh?'='copilot_gh_suggest'
fi

# ssh to a device whose key lives only in 1Password: opssh <1p-item> user@host
# IdentityAgent=none so the agent's other keys are not offered first (small devices hit MaxAuthTries).
# ?ssh-format=openssh is mandatory for 1Password-generated keys. Vault name comes from ~/.dotfiles.local.
opssh() {
  local item="$1"; shift
  [[ -z "$item" || $# -eq 0 ]] && { echo "usage: opssh <1p-item> <user@host> [ssh args]" >&2; return 2; }
  local key; key=$(mktemp) || return 1; chmod 600 "$key"
  if ! op read "op://${OPSSH_VAULT:-SSH KEYS}/${item}/private key?ssh-format=openssh" </dev/null > "$key" 2>/dev/null; then
    rm -f "$key"; echo "opssh: could not read '$item' (1Password locked?)" >&2; return 1
  fi
  ssh -o IdentitiesOnly=yes -o IdentityAgent=none -i "$key" "$@"
  local rc=$?; rm -P -f "$key" 2>/dev/null || rm -f "$key"; return $rc
}

# personal hosts, aliases and secrets-by-reference — never committed
[[ -f ~/.dotfiles.local ]] && source ~/.dotfiles.local

# login banner on every new interactive shell
[[ -o interactive && -x ~/.local/bin/banner ]] && ~/.local/bin/banner
